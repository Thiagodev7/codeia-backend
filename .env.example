# --- Banco de Dados ---
DATABASE_URL="postgresql://user:password@localhost:5432/codeia_db"

# --- Redis (Filas e Cache) ---
REDIS_URL="redis://localhost:6379"

# --- Autenticação ---
JWT_SECRET="changeme_min_32_chars_random_string"

# --- Inteligência Artificial (Google Gemini) ---
# Obter chave em: https://aistudio.google.com/
GOOGLE_AI_KEY="your_gemini_api_key_here"

# --- Servidor ---
PORT=3333
NODE_ENV="development"
