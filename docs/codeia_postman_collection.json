{
	"info": {
		"_postman_id": "c98c809c-9b12-4c79-939d-d0398347443a",
		"name": "CodeIA Backend API",
		"description": "Coleção de requisições para a API do CodeIA Backend (v2.0).\n\nPara usar:\n1. Importe esta coleção no Postman.\n2. Crie um Environment no Postman com a variável `baseUrl` definida como `http://localhost:3333`.\n3. Faça login na pasta 'Auth' -> 'Login' para obter o token.\n4. O token será salvo automaticamente na variável de ambiente `token` (se configurado script de teste) ou copie manualmente para o Header da coleção.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "🔐 Auth",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"pm.environment.set(\"token\", jsonData.token);",
									"pm.environment.set(\"tenantId\", jsonData.user.tenantId);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@empresa.com\",\n    \"password\": \"senha123\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"login"
							]
						},
						"description": "Realiza login e salva o token automaticamente no ambiente."
					},
					"response": []
				},
